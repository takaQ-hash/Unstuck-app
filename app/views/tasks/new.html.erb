<h1 class="text-xl font-bold mb-4">タスク登録</h1>

<%= form_with model: @task, data: { controller: "notification-type" } do |f| %>
  <% if @task.errors.any? %>
    <div class="text-red-600 mb-4">
      <ul>
        <% @task.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :name, "タスク名", class: "block font-bold mb-1" %>
    <%= f.text_field :name, class: "border rounded w-full p-2" %>
  </div>

  <div class="mb-4">
    <%= f.label :deadline, "締切日", class: "block font-bold mb-1" %>
    <%= f.date_field :deadline, class: "border rounded p-2" %>
  </div>

  <div class="mb-4">
    <p class="font-bold mb-2">通知タイミング設定</p>

    <label class="mr-4">
      <%= f.radio_button :notification_type,  "interval", checked: @task.notification_type.nil? || @task.notification_type == "interval", data: { action: "change->notification-type#toggle" } %>
      時間間隔
    </label>
    <label>
      <%= f.radio_button :notification_type, "fixed_time", data: { action: "change->notification-type#toggle" } %>
      固定時間
    </label>

    <div class="mt-2">
      <span data-notification-type-target="intervalLabel">通知時間間隔（何分ごと）</span>
      <span data-notification-type-target="fixedTimeLabel" class="hidden">通知時刻（HH:MM）</span>
      <%= f.text_field :notification_value, data: { notification_type_target: "valueInput" }, class: "border rounded p-2" %>
    </div>
  </div>

  <%= f.submit "登録", class: "bg-blue-500 text-white px-4 py-2 rounded" %>
<% end %>