<h1 class="text-xl font-bold mb-4">報告編集</h1>

<div class="border rounded p-4 bg-gray-50 mb-4">
  <p class="font-bold">タスク名</p>
  <p class="mb-2"><%= @task.name %></p>
  <p class="font-bold">締切日</p>
  <p><%= @task.deadline %></p>
</div>

<%= render "form", report: @report, url: task_report_path(@task, @report) %>

<%= link_to "戻る", task_path(@task), class: "border px-3 py-1 text-sm rounded" %>