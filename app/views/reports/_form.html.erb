<%= form_with model: report, url: url do |f| %>
  <% if report.errors.any? %>
    <div class="text-red-600 mb-6 text-sm">
      <ul>
        <% report.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-6">
    <p class="font-bold mb-3 text-accent-900">進捗ステータス</p>
    <label class="mr-4">
      <%= f.radio_button :status, "in_progress" %>
      進行中
    </label>
    <label>
      <%= f.radio_button :status, "struggling" %>
      奮闘中
    </label>
  </div>

  <div class="mb-8">
    <%= f.label :memo, "一言メモ", class: "block font-bold mb-2 text-accent-900" %>
    <%= f.text_area :memo, class: "border border-accent-100 rounded-xl w-full p-2 focus:border-accent-500 focus:outline-none", rows: 4 %>
  </div>

  <div class="flex justify-center items-center gap-4">
     <%= link_to "戻る", back_path, class: "border border-accent-100 px-3 py-1 text-sm rounded-full text-center hover:bg-accent-100" %>
    <%= f.submit report.persisted? ? "更新" : "報告", class: "bg-accent-500 hover:bg-accent-700 text-white px-6 py-2 text-sm font-bold rounded-full" %>
  </div>
<% end %>