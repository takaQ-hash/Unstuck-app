<div class="container mx-auto px-4 py-8 max-w-2xl">
  <h1 class="font-heading text-3xl font-bold text-center mb-8 text-brand-900">新規登録</h1>

  <div class="border border-brand-100 rounded-2xl p-6 bg-white">
    <%= form_with model: resource, as: resource_name, url: registration_path(resource_name), data: { controller: "registration" } do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-6">
        <%= f.label :name, "お名前", class: "block font-bold mb-2 text-brand-900" %>
        <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "border border-brand-100 rounded-xl w-full p-2 focus:border-brand-500 focus:outline-none" %>
      </div>

      <div class="mb-6">
        <%= f.label :email, "メールアドレス", class: "block font-bold mb-2 text-brand-900" %>
        <%= f.email_field :email, autocomplete: "email", class: "border border-brand-100 rounded-xl w-full p-2 focus:border-brand-500 focus:outline-none" %>
      </div>

      <div class="mb-6">
        <%= f.label :password, "パスワード", class: "block font-bold mb-2 text-brand-900" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-gray-400 mb-1">(<%= @minimum_password_length %>文字以上)</p>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password", class: "border border-brand-100 rounded-xl w-full p-2 focus:border-brand-500 focus:outline-none" %>
      </div>

      <div class="mb-8">
        <%= f.label :password_confirmation, "パスワード（確認用）", class: "block font-bold mb-2 text-brand-900" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "border border-brand-100 rounded-xl w-full p-2 focus:border-brand-500 focus:outline-none" %>
      </div>

      <div class="mb-4 space-y-2">
        <details class="text-sm border border-brand-100 rounded-xl p-3">
          <summary class="cursor-pointer font-bold text-brand-900">利用規約を確認する</summary>
          <div class="mt-3 max-h-48 overflow-y-auto">
            <%= render "pages/terms_content" %>
          </div>
        </details>

        <details class="text-sm border border-brand-100 rounded-xl p-3">
          <summary class="cursor-pointer font-bold text-brand-900">プライバシーポリシーを確認する</summary>
          <div class="mt-3 max-h-48 overflow-y-auto">
            <%= render "pages/privacy_content" %>
          </div>
        </details>
      </div>

      <div class="mb-6 flex items-start gap-2">
        <%= check_box_tag :agree_terms, "1", false, class: "mt-1", data: { registration_target: "checkbox", action: "change->registration#toggle" } %>
        <%= label_tag :agree_terms, "利用規約・プライバシーポリシーに同意する", class: "text-sm text-brand-900" %>
      </div>

      <div class="flex justify-center">
        <%= f.submit "登録する", data: { registration_target: "submitButton" }, disabled: true, class: "bg-brand-600 hover:bg-brand-900 disabled:bg-gray-300 disabled:hover:bg-gray-300 disabled:cursor-not-allowed text-white px-6 py-2 text-sm font-bold rounded-full" %>
      </div>
    <% end %>
  </div>

  <div class="text-center mt-4 text-sm">
    <%= render "devise/shared/links" %>
  </div>
</div>