<h1 class="text-xl font-bold mb-4">タスク詳細</h1>

<div class="border rounded p-4 bg-gray-50 mb-6">
  <h2 class="font-bold text-lg">タスク名</h2>
  <p class="mb-4"><%= @task.name %></p>

  <h2 class="font-bold text-lg">締切日</h2>
  <p><%= @task.deadline %></p>
</div>

<div class="flex gap-2 mb-6">
  <%= link_to "戻る", tasks_path, class: "border px-3 py-1 text-sm rounded text-center" %>
  <%= link_to "タスク編集", edit_task_path(@task), class: "border px-3 py-1 text-sm rounded text-center" %>
  <%= button_to "タスク削除", task_path(@task), method: :delete, data: { turbo_confirm: "タスク「#{@task.name}」を削除しますか？" }, 
    class: "border px-3 py-1 text-sm rounded text-center bg-red-500 text-white" %>
</div>

<div class="border-t pt-4">
  <div class="flex justify-between items-center mb-2">
    <p class="font-bold">報告履歴一覧</p>
    <%= link_to "報告", "#", class: "border px-3 py-1 text-sm rounded" %>
  </div>

  <p class="text-gray-500 text-sm">まだ報告がありません</p>
</div>