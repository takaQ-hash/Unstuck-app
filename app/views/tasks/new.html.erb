<div class="container mx-auto px-4 py-8 max-w-2xl">
  <%= render "shared/breadcrumb", items: [
    { label: "タスク一覧", path: tasks_path },
    { label: "タスク登録", path: nil }
  ] %>
  <h1 class="font-heading text-3xl font-bold text-center mb-8 text-brand-900">タスク登録</h1>
  <%= render "form", task: @task, url: tasks_path(back_path: @back_path) %>
</div>