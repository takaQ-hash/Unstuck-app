<div class="container mx-auto px-4 py-8 max-w-2xl">
  <h1 class="font-heading text-3xl font-bold text-center mb-8 text-brand-900">タスク一覧</h1>

  <div class="space-y-4">
    <% if @tasks.present? %>
      <%= render @tasks %>
    <% else %>
      <p class="text-center text-brand-600">まだタスクがありません。最初のタスクを登録してみましょう。</p>
    <% end %>
  </div>

  <div class="flex justify-center mt-8">
    <%= link_to "タスク登録", new_task_path, class: "bg-brand-600 hover:bg-brand-900 text-white px-4 py-2 rounded-full" %>
  </div>
</div>
