<div class="container mx-auto px-4 py-8 max-w-2xl">
  <h1 class="font-heading text-3xl font-bold text-center mb-8 text-brand-900">パスワードをお忘れですか？</h1>

  <div class="border border-brand-100 rounded-2xl p-6 bg-white">
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-8">
        <%= f.label :email, "メールアドレス", class: "block font-bold mb-2 text-brand-900" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "border border-brand-100 rounded-xl w-full p-2 focus:border-brand-500 focus:outline-none" %>
      </div>

      <div class="flex justify-center">
        <%= f.submit "再設定メールを送信する", class: "bg-brand-600 hover:bg-brand-900 text-white px-6 py-2 text-sm font-bold rounded-full cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <div class="text-center mt-4 text-sm">
    <%= render "devise/shared/links" %>
  </div>
</div>