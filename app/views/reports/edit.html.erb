<div class="container mx-auto px-4 py-8 max-w-2xl">
  <h1 class="font-heading text-3xl font-bold text-center mb-8 text-brand-900">報告編集</h1>

  <%= render "shared/task_summary", task: @task %>

  <%= render "form", report: @report, url: task_report_path(@task, @report) %>

  <div class="flex justify-center mt-4">
    <%= link_to "戻る", task_path(@task), class: "border border-brand-100 px-3 py-1 text-sm rounded-full text-center hover:bg-brand-50" %>
  </div>
</div>