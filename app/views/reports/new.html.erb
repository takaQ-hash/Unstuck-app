<div class="container mx-auto px-4 py-8 max-w-2xl">
  <%= render "shared/breadcrumb", items: [
    { label: "タスク一覧", path: tasks_path },
    { label: "タスク詳細", path: task_path(@task) },
    { label: "報告登録", path: nil }
  ] %>
  <h1 class="font-heading text-3xl font-bold text-center mb-8 text-accent-900">報告登録</h1>

  <%= render "shared/task_summary", task: @task %>

  <%= render "form", report: @report, url: task_reports_path(@task, back_path: @back_path), back_path: @back_path %>
</div>