<div class="container mx-auto px-4 py-8 max-w-2xl">
  <h1 class="font-heading text-3xl font-bold text-center mb-8 text-brand-900">タスク詳細</h1>

  <%= render "shared/task_summary", task: @task %>

  <div class="flex gap-2 justify-center mb-6">
    <%= link_to "戻る", tasks_path, class: "border border-brand-100 px-3 py-1 text-sm rounded-full text-center hover:bg-brand-50" %>
    <%= link_to "タスク編集", edit_task_path(@task), class: "bg-brand-600 hover:bg-brand-900 text-white px-3 py-1 text-sm rounded-full text-center border border-brand-900" %>
    <%= button_to "タスク削除", task_path(@task), method: :delete, data: { turbo_confirm: "タスク「#{@task.name}」を削除しますか？" },
      class: "px-3 py-1 text-sm rounded-full text-center bg-red-500 hover:bg-red-700 text-white border border-red-700" %>
  </div>

  <div class="border-t border-brand-100 pt-4">
    <p class="font-bold text-brand-900">報告履歴一覧</p><br>
    <% if @reports.present? %>
      <%= render @reports %>
    <% else %>
      <p class="text-center text-brand-600 text-sm">まだ報告がありません。最初の報告を記録してみましょう。</p>
    <% end %>
    <br>
    <div class="flex justify-center mb-4">
      <%= link_to "報告する", new_task_report_path(@task), class: "bg-accent-500 hover:bg-accent-900 text-white px-6 py-2 text-sm font-bold rounded-full" %>
    </div>  
  </div>
</div>