<div id="report-id-<%= report.id %>" class="border rounded p-4 bg-gray-50 mb-2">
  <div class="flex justify-between items-start">
    <div>
      <p class="text-sm text-gray-600"><%= report.created_at.strftime("%-m/%-d %H:%M") %></p>
      <p class="text-sm mt-1">
        <span class="<%= report.in_progress? ? "text-green-600 font-bold" : "text-red-600 font-bold" %>">
          <%= report.in_progress? ? "進行中" : "奮闘中" %>
        </span>
      </p>
      <p class="text-sm mt-1"><%= report.memo %></p>
    </div>
    <div class="flex flex-col gap-1">
      <%= link_to "編集", edit_task_report_path(report.task, report), class: "border px-3 py-1 text-sm rounded text-center" %>
      <%= button_to "削除", task_report_path(report.task, report), method: :delete,
            data: { turbo_confirm: "この報告を削除しますか？" },
            class: "border px-3 py-1 text-sm rounded text-center bg-red-500 text-white" %>
    </div>
  </div>
</div>