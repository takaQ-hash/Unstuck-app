<div class="container mx-auto px-4 py-8 max-w-2xl">
  <h1 class="font-heading text-3xl font-bold text-center mb-8 text-brand-900">パスワードの再設定</h1>

  <div class="border border-brand-100 rounded-2xl p-6 bg-white">
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="mb-6">
        <%= f.label :password, "新しいパスワード", class: "block font-bold mb-1 text-brand-900" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-gray-400 mb-2">(<%= @minimum_password_length %>文字以上)</p>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "border border-brand-100 rounded-xl w-full p-2 focus:border-brand-500 focus:outline-none" %>
      </div>

      <div class="mb-8">
        <%= f.label :password_confirmation, "新しいパスワード（確認用）", class: "block font-bold mb-2 text-brand-900" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "border border-brand-100 rounded-xl w-full p-2 focus:border-brand-500 focus:outline-none" %>
      </div>

      <div class="flex justify-center">
        <%= f.submit "パスワードを変更する", class: "bg-brand-600 hover:bg-brand-900 text-white px-6 py-2 text-sm font-bold rounded-full cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <div class="text-center mt-4 text-sm">
    <%= render "devise/shared/links" %>
  </div>
</div>